[Unit]
Description=Agent Games outbound HTTPS tunnel
After=network-online.target agentgames-gatekeeper.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/root/apps/agentgames-gatekeeper/tools/cloudflared tunnel --url http://127.0.0.1:20218 --metrics 127.0.0.1:20241 --no-autoupdate --protocol http2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=150M

[Install]
WantedBy=multi-user.target
